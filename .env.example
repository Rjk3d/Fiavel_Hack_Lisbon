# Network (deployments/<network>.json holds the contract IDs)
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Agent keys (server-side only, never commit real keys).
# Without them, local development uses the `stellar keys` identities fiavel-<role>.
COORDINATOR_SECRET_KEY=
LANDLORD_SECRET_KEY=
TENANT_SECRET_KEY=
