# Network (deployments/<network>.json holds the contract IDs)
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Agent keys (server-side only, never commit real keys).
# Without them, local development uses the `stellar keys` identities fiavel-<role>.
COORDINATOR_SECRET_KEY=
LANDLORD_SECRET_KEY=
TENANT_SECRET_KEY=

# New-escrow eligibility only. Existing provider bindings are immutable.
ESCROW_PROVIDER_MODE=leasevault
# Server-only Core API v2 key (id.secret). Never expose through VITE_*.
# Trustless Work writes remain blocked until deployment/roles/fees are verified.
TW_API_KEY=
