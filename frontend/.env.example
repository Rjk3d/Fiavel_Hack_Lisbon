# Server-only values. No AI key, model, or URL belongs in a VITE_ variable.
# The rental assistant uses a deterministic demo; reviews use the local API.
AI_PROVIDER=disabled
# Set json-gateway only after implementing the documented JSON gateway contract.
AI_GATEWAY_URL=
AI_API_KEY=
AI_MODEL=
AI_ALLOW_EXTERNAL=false
AI_APP_ORIGIN=http://localhost:5173
AI_PORT=8787

# Explicit fictional review backend. No live tenant authentication is provided.
REVIEWS_DEMO=true
# Private local SQLite file. Never use the same file for demo and live records.
REVIEWS_DB_PATH=.data/reviews-demo.sqlite
# npm run dev starts Vite + API together. DEV_PORT selects its frontend port.
# DEV_PORT=5173
# Optional Vite proxy target, for example http://127.0.0.1:8788
# FIAVEL_API_TARGET=http://127.0.0.1:8787
